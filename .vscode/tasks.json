{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: build all",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/menu.cpp",
        "${workspaceFolder}/src/display.cpp",
        "${workspaceFolder}/src/score_manager.cpp",
        "${workspaceFolder}/src/game.cpp",
        "${workspaceFolder}/src/game_logic.cpp",
        "${workspaceFolder}/src/game_threads.cpp",
        "${workspaceFolder}/src/game_screen.cpp",
        "-o",
        "${workspaceFolder}/lumines",
        "-pthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}
